# -----------------------------------------------------------------------------
# main.tf
# The resources we want Azure to create. Terraform works out the order
# from the references between them (e.g. the subnet needs the VNet's name).
# -----------------------------------------------------------------------------

# Locals are named values computed inside the config - handy to avoid repetition
locals {
  name = "${var.prefix}-${var.location}"

  common_tags = merge(var.tags, {
    managed_by = "terraform"
  })
}

# 1. Resource group - a container for everything else
resource "azurerm_resource_group" "demo" {
  name     = "rg-${local.name}"
  location = var.location
  tags     = local.common_tags
}

# 2. Networking: virtual network + subnet
resource "azurerm_virtual_network" "demo" {
  name                = "vnet-${local.name}"
  address_space       = ["10.0.0.0/16"]
  location            = azurerm_resource_group.demo.location
  resource_group_name = azurerm_resource_group.demo.name
  tags                = local.common_tags
}

resource "azurerm_subnet" "demo" {
  name                 = "snet-default"
  resource_group_name  = azurerm_resource_group.demo.name
  virtual_network_name = azurerm_virtual_network.demo.name
  address_prefixes     = ["10.0.1.0/24"]
}

# 3. Public IP so we can reach the VM from the internet
resource "azurerm_public_ip" "demo" {
  name                = "pip-${local.name}"
  location            = azurerm_resource_group.demo.location
  resource_group_name = azurerm_resource_group.demo.name
  allocation_method   = "Static"
  sku                 = "Standard"
  tags                = local.common_tags
}

# 4. Network security group (firewall) allowing RDP in
resource "azurerm_network_security_group" "demo" {
  name                = "nsg-${local.name}"
  location            = azurerm_resource_group.demo.location
  resource_group_name = azurerm_resource_group.demo.name
  tags                = local.common_tags

  security_rule {
    name                       = "allow-rdp"
    priority                   = 1001
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "3389"
    source_address_prefix      = var.allowed_rdp_cidr
    destination_address_prefix = "*"
  }
}

# 5. Network interface - plugs the VM into the subnet and public IP
resource "azurerm_network_interface" "demo" {
  name                = "nic-${local.name}"
  location            = azurerm_resource_group.demo.location
  resource_group_name = azurerm_resource_group.demo.name
  tags                = local.common_tags

  ip_configuration {
    name                          = "internal"
    subnet_id                     = azurerm_subnet.demo.id
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = azurerm_public_ip.demo.id
  }
}

resource "azurerm_network_interface_security_group_association" "demo" {
  network_interface_id      = azurerm_network_interface.demo.id
  network_security_group_id = azurerm_network_security_group.demo.id
}

# 6. Admin password, generated by the random provider.
resource "random_password" "admin" {
  length           = 20
  special          = true
  min_lower        = 1
  min_upper        = 1
  min_numeric      = 1
  min_special      = 1
  override_special = "!#%*-_=+?"
}

# 7. The virtual machine itself
resource "azurerm_windows_virtual_machine" "demo" {
  name                  = "vm-${local.name}"
  computer_name         = "${var.prefix}-vm" # Windows hostnames max out at 15 characters
  location              = azurerm_resource_group.demo.location
  resource_group_name   = azurerm_resource_group.demo.name
  size                  = var.vm_size
  admin_username        = var.admin_username
  admin_password        = random_password.admin.result
  network_interface_ids = [azurerm_network_interface.demo.id]
  tags                  = local.common_tags

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "Standard_LRS"
  }

  source_image_reference {
    publisher = "MicrosoftWindowsServer"
    offer     = "WindowsServer"
    sku       = "2022-datacenter-azure-edition"
    version   = "latest"
  }
}
